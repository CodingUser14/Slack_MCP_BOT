{
    "display_information": {
        "name": "InfoBot",
        "description": "Create Custom Messages For You!",
        "background_color": "#2745a1"
    },
    "features": {
        "bot_user": {
            "display_name": "Demo App",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write.customize",
                "assistant:write",
                "chat:write",
                "im:write"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}